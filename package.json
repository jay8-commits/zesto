    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
